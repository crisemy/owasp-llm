# OWASP LLM Security — Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to version control

# OpenAI API Key (for --target openai)
OPENAI_API_KEY=

# Anthropic API Key (for --target anthropic)
ANTHROPIC_API_KEY=

# OpenRouter API Key (for --target custom with OpenRouter endpoint)
OPENROUTER_API_KEY=

# Custom API Key (generic, for any custom endpoint)
CUSTOM_API_KEY=

# Default model for custom/OpenRouter targets
CUSTOM_MODEL=openai/gpt-4o

# Custom API endpoint URL
CUSTOM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
